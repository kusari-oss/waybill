# Must match `channel` in rust-toolchain.toml. This image builds the main
# workspace, and the repo's toolchain file is copied in, so a mismatch makes
# rustup download the pinned toolchain inside the container -- slow, and it
# defeats the point of pinning the base image at all.
FROM rust:1.98.1-bookworm

# eBPF build dependencies + curl/jq for ad-hoc tooling inside the container.
RUN apt-get update && apt-get install -y \
    clang \
    llvm \
    libelf-dev \
    linux-headers-generic \
    pkg-config \
    libssl-dev \
    curl \
    ca-certificates \
    jq \
    dpkg-dev \
    && rm -rf /var/lib/apt/lists/*

# Install nightly toolchain for eBPF target and bpf-linker
RUN rustup toolchain install nightly \
    && rustup component add rust-src --toolchain nightly \
    && cargo +nightly install bpf-linker

WORKDIR /waybill
COPY . .

# Build eBPF kernel programs first
RUN cargo run --package xtask -- ebpf 2>&1 || echo "eBPF build result: $?"

# Build the userspace binary
RUN cargo build --release 2>&1

# Run tests
RUN cargo test --workspace 2>&1
