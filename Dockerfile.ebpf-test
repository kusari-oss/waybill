# Container-based eBPF integration test harness for m210.
#
# Runs waybill trace against the two_binaries_diverge fixture INSIDE
# the container and asserts the emitted attestation carries the
# expected compiler-pipeline metadata. The container needs CAP_BPF
# + CAP_PERFMON when run, so invocation is:
#
#   docker run --rm --privileged waybill-ebpf-test
#
# `--privileged` is required for eBPF; `--rm` cleans up after.
#
# The image bakes in the full m210 build + fixture; the entrypoint
# script runs the trace + assertion. Exits 0 on success, non-zero
# on any failure.

# Must match `channel` in rust-toolchain.toml. This image builds the main
# workspace, and the repo's toolchain file is copied in, so a mismatch makes
# rustup download the pinned toolchain inside the container -- slow, and it
# defeats the point of pinning the base image at all.
FROM rust:1.98.1-bookworm

# eBPF build deps + runtime tools the trace-run needs (gcc for the
# fixture's compiler-invocation traffic; jq for the assertion script;
# zstd + curl for the bpf-linker binary download below).
RUN apt-get update && apt-get install -y \
    clang \
    llvm \
    libelf-dev \
    linux-headers-generic \
    pkg-config \
    libssl-dev \
    gcc \
    jq \
    curl \
    zstd \
    && rm -rf /var/lib/apt/lists/*

# m234 US1b (2026-08-13): install method switched from `cargo install`
# to pre-built binary from aya-rs/bpf-linker GH releases. Rationale:
# v0.11.0 removed the rustc-llvm-proxy shim and now requires system
# LLVM 22, which Debian bookworm doesn't ship. The pre-built musl
# binary statically links LLVM 22 in.
#
# The ARG default MUST match .github/env/bpf-linker.env (guarded by
# .github/workflows/pin-consistency.yml). CI passes the env value in
# via `docker build --build-arg BPF_LINKER_VERSION=$(...)`.
ARG BPF_LINKER_VERSION=0.11.0
# #1089 — the eBPF nightly comes from waybill-ebpf/rust-toolchain.toml, copied
# alone so this layer is rebuilt only when the pin moves.
COPY waybill-ebpf/rust-toolchain.toml /tmp/ebpf-rust-toolchain.toml
RUN channel=$(sed -n 's/^channel *= *"\(.*\)"/\1/p' /tmp/ebpf-rust-toolchain.toml) \
    && rustup toolchain install "$channel" --profile minimal --component rust-src \
    && arch=$(uname -m) \
    && case "$arch" in \
         x86_64|amd64) triple="x86_64-unknown-linux-musl" ;; \
         aarch64|arm64) triple="aarch64-unknown-linux-musl" ;; \
         *) echo "unsupported arch $arch" && exit 1 ;; \
       esac \
    && url="https://github.com/aya-rs/bpf-linker/releases/download/v${BPF_LINKER_VERSION}/bpf-linker-${triple}.tar.zst" \
    && curl -sSL --retry 3 --fail -o /tmp/bpf-linker.tar.zst "$url" \
    && tar --zstd -xf /tmp/bpf-linker.tar.zst -C /usr/local/bin bpf-linker \
    && chmod +x /usr/local/bin/bpf-linker \
    && rm /tmp/bpf-linker.tar.zst \
    && bpf-linker --help >/dev/null 2>&1 || true

WORKDIR /waybill

# COPY the waybill source tree.
#
# This comment used to claim that `.dockerignore` excludes `scripts/`
# from this COPY, so that editing an assertion script would not
# invalidate the ~10-minute cargo-build layer below. It does not:
# `scripts/` has never been in `.dockerignore`, so this COPY pulls it in
# and an edit to the harness does invalidate the cargo layers.
#
# Left as it is rather than "fixed". `.dockerignore` filters the build
# context, so excluding `scripts/` would make the explicit `COPY
# scripts/...` lines below fail outright, and a negation exception would
# put the files back in the context where the bulk COPY picks them up
# again. Making the claim true needs the bulk COPY to name its paths or
# use BuildKit's `COPY --exclude`, which is a change to a 10-minute
# cached build that no measurement here calls for. The comment is now
# accurate, which is the part that was costing anything.
COPY . .

# Build eBPF kernel bytecode + userspace binary with ebpf-tracing on.
# The two-stage build lets Docker cache the eBPF layer independently
# of the userspace changes.
RUN cargo run --package xtask -- ebpf
RUN cargo build --release --features ebpf-tracing --bin waybill

# Re-COPY the scripts LAST, to the paths the container actually invokes.
# This does not save the cargo layer (see above) but it does mean the
# invoked copy is the edited one regardless of layer caching.
COPY scripts/ebpf-integration-test.sh /usr/local/bin/ebpf-integration-test.sh
# #1185 — the handshake establishment-rate probe. Not the ENTRYPOINT:
# it is run by passing `--entrypoint` explicitly (see
# scripts/ebpf-container-run.sh), so the default behaviour of this image
# is unchanged and the CI lane that depends on it cannot be altered by
# adding a measurement.
COPY scripts/ebpf-handshake-rate.sh /usr/local/bin/ebpf-handshake-rate.sh
RUN chmod +x /usr/local/bin/ebpf-integration-test.sh \
             /usr/local/bin/ebpf-handshake-rate.sh

ENTRYPOINT ["/usr/local/bin/ebpf-integration-test.sh"]
