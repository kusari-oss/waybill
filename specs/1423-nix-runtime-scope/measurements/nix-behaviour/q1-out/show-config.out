abort-on-warn = false
accept-flake-config = false
access-tokens = 
allow-dirty = true
allow-dirty-locks = false
allow-import-from-derivation = true
allow-symlinked-store = false
allow-unsafe-native-code-during-evaluation = false
allowed-impure-host-deps = /System/Library /bin/sh /dev /usr/lib
allowed-uris = 
allowed-users = *
always-allow-substitutes = true
auto-optimise-store = false
bash-prompt = 
bash-prompt-prefix = (nix:$name)\040
bash-prompt-suffix = 
build-dir = 
build-hook = /nix/var/nix/profiles/default/bin/nix __build-remote
build-poll-interval = 5
build-provenance-tags = {}
build-users-group = 
builders = @/etc/nix/machines
builders-use-substitutes = false
commit-lock-file-summary = 
compress-build-log = true
connect-timeout = 15
cores = 0
darwin-log-sandbox-violations = false
debugger-on-trace = false
debugger-on-warn = false
diff-hook = 
download-attempts = 5
download-buffer-size = 1048576
download-speed = 0
eval-attrset-update-layer-rhs-threshold = 16
eval-cache = true
eval-cores = 0
eval-profile-file = nix.profile
eval-profiler = disabled
eval-profiler-frequency = 99
eval-system = 
experimental-features = 
external-builders = []
extra-platforms = x86_64-darwin
fallback = false
flake-registry = https://install.determinate.systems/flake-registry/stable/flake-registry.json
fsync-metadata = true
fsync-store-paths = false
gc-reserved-space = 8388608
hashed-mirrors = 
host-name = 
http-connections = 25
http2 = true
id-count = 128
ignore-try = false
impersonate-linux-26 = false
json-log-path = 
keep-build-log = true
keep-derivations = true
keep-env-derivations = false
keep-failed = false
keep-going = false
keep-outputs = false
lazy-locks = false
lazy-trees = true
lint-absolute-path-literals = ignore
lint-short-path-literals = ignore
lint-url-literals = ignore
log-lines = 25
max-build-log-size = 0
max-call-depth = 10000
max-free = 9223372036854775807
max-jobs = 18
max-silent-time = 0
max-substitution-jobs = 16
min-free = 0
min-free-check-interval = 5
nar-buffer-size = 33554432
narinfo-cache-meta-ttl = 604800
narinfo-cache-negative-ttl = 3600
narinfo-cache-positive-ttl = 2592000
netrc-file = /nix/var/determinate/netrc
nix-219-compat = false
nix-path = nixpkgs=flake:https://flakehub.com/f/DeterminateSystems/nixpkgs-weekly/*.tar.gz
nix-shell-always-looks-for-shell-nix = true
nix-shell-shebang-arguments-relative-to-script = true
plugin-files = 
post-build-hook = 
pre-build-hook = 
preallocate-contents = false
print-missing = true
pure-eval = true
require-drop-supplementary-groups = false
require-sigs = true
restrict-eval = false
run-diff-hook = false
sandbox = false
sandbox-fallback = true
sandbox-paths = /System/Library/Frameworks /System/Library/PrivateFrameworks /bin/bash /bin/sh /private/tmp /private/var/tmp /usr/lib
secret-key-files = 
session-id = 
show-trace = false
ssl-cert-file = /etc/nix/macos-keychain.crt
stalled-download-timeout = 300
start-id = 56930
store = auto
substitute = true
substituters = https://cache.nixos.org/ https://install.determinate.systems
sync-before-registering = false
system = aarch64-darwin
system-features = apple-virt benchmark big-parallel nixos-test
tarball-ttl = 3600
timeout = 0
trace-function-calls = false
trace-import-from-derivation = false
trace-verbose = false
