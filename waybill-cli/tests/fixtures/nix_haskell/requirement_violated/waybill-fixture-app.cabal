cabal-version:      2.4
name:               waybill-fixture-app
version:            0.1.0.0
license:            BSD-3-Clause

-- Issue #1457. The seeded package set carries waybill-fixture-dep 2.2.0.0,
-- but this project requires >= 2.3: a flake overlay pinned the version that
-- was actually built, and the package set does not see overlays. The package
-- set's version contradicts the declaration, so it must not be emitted.
--
-- waybill-fixture-liba is the in-document control: its range admits the
-- package set's 1.2.3, so it resolves exactly as before.
library
    exposed-modules:  Fixture
    build-depends:    waybill-fixture-dep >= 2.3
                    , waybill-fixture-liba >=1.0 && <2
    default-language: Haskell2010
