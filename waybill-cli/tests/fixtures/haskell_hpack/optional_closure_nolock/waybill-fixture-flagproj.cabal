cabal-version: 2.4
name:          waybill-fixture-flagproj
version:       0.1.0
license:       MIT

flag cli
  description: Build the optional CLI.
  default:     False
  manual:      True

library
  build-depends:   waybill-fixture-kept
  exposed-modules: Lib
  hs-source-dirs:  src

executable waybill-fixture-flagproj-cli
  main-is: Main.hs
  hs-source-dirs: src
  if flag(cli)
    buildable: True
  else
    buildable: False
  build-depends:
      waybill-fixture-marked-a
    , waybill-fixture-marked-b
    , waybill-fixture-contested
